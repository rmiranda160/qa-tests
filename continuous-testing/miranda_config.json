{
  "applications": [
    {
      "name": "Cenarbe Bike Rental",
      "url": "https://dev1.cenarbe.com/",
      "critical_buttons": [
        {
          "name": "Botón Login",
          "selector": "a.btn:has-text('Login')",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón Registro",
          "selector": "a.btn:has-text('Registro')",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón Buscar Disponibilidad",
          "selector": "button:has-text('Buscar Disponibilidad')",
          "type": "button",
          "critical": false
        },
        {
          "name": "Botón Carrito",
          "selector": "a[href='/carrito.php']",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón Ver Bicicletas",
          "selector": "a:has-text('Ver Bicicletas')",
          "type": "button",
          "critical": false
        },
        {
          "name": "Formulario Reserva",
          "selector": "form[action='/bicicletas.php']",
          "type": "form",
          "critical": true
        }
      ]
    },
    {
      "name": "ContentoAI",
      "url": "https://contentoai.cenarbe.com/",
      "critical_buttons": [
        {
          "name": "Botón Ver Demo",
          "selector": "a:has-text('Ver demo'), a.btn-secondary:has-text('Ver demo')",
          "type": "link",
          "critical": true
        },
        {
          "name": "Formulario Waitlist",
          "selector": "form#waitlistForm, form.waitlist-form, form input[type='email']",
          "type": "form",
          "critical": true
        }
      ]
    },
    {
      "name": "Villa Zocotin",
      "url": "https://villazocotin.cenarbe.com/",
      "critical_buttons": [
        {
          "name": "Enlace Reservar (ancla al formulario)",
          "selector": "a:has-text('Reservar')",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón Confirmar Reserva",
          "selector": "button:has-text('Confirmar reserva')",
          "type": "button",
          "critical": true
        },
        {
          "name": "Formulario de Reserva",
          "selector": "form:has-text('Reservar')",
          "type": "form",
          "critical": true
        },
        {
          "name": "Sección Contacto",
          "selector": "footer",
          "type": "element",
          "critical": false
        }
      ]
    },
    {
      "name": "Dashboard",
      "url": "https://dashboard.cenarbe.com/",
      "critical_buttons": [
        {
          "name": "Botón Refresh Data",
          "selector": "button:has-text('Refresh'), button:has-text('Actualizar'), #refresh-btn, button[onclick*='refresh']",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón View Alert Details",
          "selector": ".alert-card, a:has-text('Details'), button:has-text('Ver detalles'), .alert-details-btn, [href*='details']",
          "type": "element",
          "critical": true
        },
        {
          "name": "Botón Export Report",
          "selector": "button:has-text('Export'), button:has-text('Exportar'), #export-btn, button[onclick*='export']",
          "type": "button",
          "critical": true
        },
        {
          "name": "Botón Configure Alerts",
          "selector": "a:has-text('Configure'), button:has-text('Configurar'), [href*='configure'], [href*='settings']",
          "type": "button",
          "critical": true
        },
        {
          "name": "Interacción Gráficos",
          "selector": "canvas",
          "type": "element",
          "critical": false
        },
        {
          "name": "Ver Screenshots Completos",
          "selector": ".screenshot-card, [href*='screenshot'], [href*='image']",
          "type": "element",
          "critical": false
        }
      ]
    }
  ],
  "settings": {
    "ws_endpoint": "ws://51.254.244.216:3000/",
    "timeout": 10000,
    "check_interval_hours": 1,
    "alert_on_critical_fail": true,
    "generate_screenshots": true,
    "miranda_rule": {
      "functional_criteria": [
        "url_changed",
        "ajax_request_detected",
        "download_triggered",
        "modal_opened",
        "dom_updated",
        "state_changed"
      ],
      "minimum_indicators": 1,
      "timeout_ms": 2000,
      "ajax_timeout_ms": 3000
    }
  }
}